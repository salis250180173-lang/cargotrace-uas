{
  "info": {
    "name": "CargoTrace REST API",
    "description": "Postman collection for CargoTrace: Global Shipment Visibility & Tracking Platform (Laravel 13 + Sanctum).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargotrace.test\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/login"
          }
        },
        {
          "name": "Get Authenticated User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/user"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/logout"
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "List Shipments",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/shipments?per_page=15"
          }
        },
        {
          "name": "Create Shipment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 1,\n  \"destination_location_id\": 4,\n  \"cargo_type\": \"Electronics\",\n  \"weight\": 450.5,\n  \"volume\": 12.4,\n  \"shipping_cost\": 2400,\n  \"currency_code\": \"USD\",\n  \"expected_arrival\": \"2026-12-10 12:00:00\",\n  \"estimated_arrival\": \"2026-12-10 12:00:00\",\n  \"items\": [\n    { \"item_name\": \"Server Rack\", \"quantity\": 2, \"unit_weight\": 225.25 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/shipments"
          }
        },
        {
          "name": "Get Shipment Detail",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/shipments/1"
          }
        },
        {
          "name": "Update Shipment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_status\": \"BOOKED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/shipments/1"
          }
        },
        {
          "name": "Delete Shipment (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/shipments/1"
          }
        }
      ]
    },
    {
      "name": "Tracking & Exceptions",
      "item": [
        {
          "name": "Get Shipment Tracking Events",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/shipments/1/tracking"
          }
        },
        {
          "name": "Add Tracking Event",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PICKED_UP\",\n  \"location_name\": \"Port of Tanjung Priok\",\n  \"latitude\": -6.1017270,\n  \"longitude\": 106.8687360,\n  \"description\": \"Container loaded onto vessel.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/shipments/1/tracking"
          }
        },
        {
          "name": "Get Shipment Exceptions",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/shipments/1/exceptions"
          }
        },
        {
          "name": "Report Shipment Exception",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exception_type\": \"CUSTOMS_HOLD\",\n  \"severity\": \"HIGH\",\n  \"notes\": \"Awaiting customs clearance inspection.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/shipments/1/exceptions"
          }
        },
        {
          "name": "Update Exception Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INVESTIGATING\",\n  \"notes\": \"Customs broker contacted.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/exceptions/1"
          }
        }
      ]
    },
    {
      "name": "Resources (Carriers & Locations)",
      "item": [
        {
          "name": "List Carriers",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/carriers"
          }
        },
        {
          "name": "Create Carrier (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pacific Ocean Line\",\n  \"code\": \"POL\",\n  \"contact_email\": \"ops@pacificline.com\",\n  \"contact_phone\": \"+65-6000-0100\",\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/carriers"
          }
        },
        {
          "name": "List Locations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/locations"
          }
        },
        {
          "name": "Create Location (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Port of Tokyo\",\n  \"country\": \"Japan\",\n  \"location_code\": \"JPTYO\",\n  \"latitude\": 35.6350000,\n  \"longitude\": 139.7730000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/locations"
          }
        }
      ]
    }
  ]
}

